# Alibaba Cloud DashScope API Configuration
# Copy this file to .env and fill in your actual API key
# .env is gitignored and never committed

DASHSCOPE_API_KEY=your_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# For VLM experiments, choose from:
# qwen3-vl-plus (latest, strongest, Qwen3-VL MoE architecture)
# qwen3-vl-flash (faster, cheaper)
# qwen-vl-max (Qwen2-VL generation, legacy)
# qwen-vl-plus (Qwen2-VL generation, legacy)
VLM_MODEL=qwen3-vl-plus
